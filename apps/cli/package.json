{
  "name": "@evan-moon/memex",
  "mcpName": "io.github.evan-moon/memex",
  "version": "0.5.0",
  "type": "module",
  "description": "Local-first second brain with semantic search. MCP server for Claude Desktop and Claude Code.",
  "homepage": "https://github.com/evan-moon/memex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evan-moon/memex.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "Evan Moon <bboydart91@gmail.com> (https://github.com/evan-moon)",
  "bin": {
    "memex": "./dist/index.js",
    "memex-mcp": "./dist/mcp.js",
    "memex-recall": "./dist/recall.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup && cp ../../packages/embed/dist/index.js dist/embed.js && yarn workspace @memex/mcp build && cp ../mcp/dist/index.js dist/mcp.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build",
    "prepack": "cp ../../README.md . && cp ../../LICENSE .",
    "postpack": "rm -f README.md LICENSE"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@huggingface/transformers": "^3.5.1",
    "better-sqlite3": "^12.9.0",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.45.2",
    "picocolors": "^1.1.1",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@memex/core": "workspace:*",
    "@memex/db": "workspace:*",
    "@memex/embed": "workspace:*",
    "@memex/mcp": "workspace:*",
    "@memex/utils": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}

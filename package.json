{
  "name": "memex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @evan-moon/memex dev",
    "dev:app": "yarn native:electron && node scripts/dev-app.mjs",
    "dev:docs": "yarn workspace @memex/docs dev",
    "typecheck": "turbo typecheck",
    "build": "turbo build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:node": "node scripts/native-abi.mjs node",
    "native:electron": "node scripts/native-abi.mjs electron",
    "desktop": "yarn native:electron && yarn workspace @memex/desktop build && yarn workspace @memex/desktop start",
    "package:mac": "yarn native:electron && yarn workspace @memex/desktop package; yarn native:node"
  },
  "packageManager": "yarn@4.14.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
